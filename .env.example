# MicuPoker runtime configuration.
#
# Copy to .env, fill in the secrets, and keep it out of Git:
#
#   cp .env.example .env
#   chmod 600 .env
#
# systemd loads this file directly (EnvironmentFile=). For a shell session:
#
#   set -a; . ./.env; set +a
#
# Values marked REQUIRED abort the boot when missing or malformed — a release
# that came up on the wrong port would look healthy to systemd while being
# unreachable. Everything else is read through MicuPoker.Config, which falls
# back to the documented default when a value is missing or nonsensical, so a
# typo cannot take the node down mid-hand.

# --- Required ----------------------------------------------------------------

# Public hostname. Also the default WebSocket origin allow-list.
PHX_HOST=poker.example.com

# ecto://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=ecto://micupoker:CHANGE_ME@localhost/micupoker_prod

# Signs and encrypts session cookies. Generate with `mix phx.gen.secret`.
# Rotating this logs every player out.
SECRET_KEY_BASE=CHANGE_ME_64_BYTES

# The release only starts its HTTP server when this is set.
PHX_SERVER=true

# --- Network -----------------------------------------------------------------

# Loopback only: nginx is the sole public entry point. Never bind 0.0.0.0 —
# that exposes the origin directly and bypasses the Cloudflare origin guard.
BIND_IP=127.0.0.1
PORT=4100

# Ecto connection pool. Keep well under Postgres max_connections.
POOL_SIZE=10

# Comma-separated CIDRs whose forwarded headers are trusted when resolving the
# client IP. Only nginx on loopback talks to the release; widening this lets a
# client forge its own address and escape every per-IP rate limit.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Prefer CF-Connecting-IP over X-Forwarded-For, but only from a trusted proxy.
# Set this true ONLY when the record is actually proxied by Cloudflare (orange
# cloud). Check with `dig +short <host> A`: a Cloudflare address means proxied,
# your own server's address means the origin is hit directly. On a direct origin
# the app's peer is always loopback, which is trusted, so believing an inbound
# CF-Connecting-IP would let a client pick its own address and slip past every
# per-IP limit.
TRUST_CLOUDFLARE=false

# Extra WebSocket origins, comma separated. Defaults to PHX_HOST alone, which
# is what you want in production.
# CHECK_ORIGIN=https://poker.example.com,https://staging.example.com

# --- Admin -------------------------------------------------------------------

# /admin/dashboard returns 404 unless BOTH are set. The password must be at
# least 16 bytes; the dashboard exposes process, memory and query internals, so
# a weak one is worse than no dashboard at all.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# --- Game defaults -----------------------------------------------------------

DEFAULT_STARTING_CHIPS=1000
DEFAULT_SMALL_BLIND=5
DEFAULT_BIG_BLIND=10

# Seconds a player has to act before the server folds or checks for them.
TURN_TIMEOUT_SECONDS=30

# Pause between the end of one hand and the deal of the next.
NEXT_HAND_DELAY_MS=4000

# How long a disconnected player keeps their seat and stack.
DISCONNECT_GRACE_SECONDS=60

# --- Limits ------------------------------------------------------------------

# Hard ceiling on concurrent non-complete rooms.
MAX_ROOMS=100

# Seats per table. Capped at 10 regardless of what is set here.
MAX_PLAYERS_PER_ROOM=9

MAX_CHAT_MESSAGE_LENGTH=300

# Minimum spacing between two chat messages / two actions from one player.
CHAT_RATE_LIMIT_MS=1200
ACTION_RATE_LIMIT_MS=400

# --- Cleanup -----------------------------------------------------------------

# A table process with no connected players shuts down after this long. Its
# state is already persisted, so it restarts on the next visit.
TABLE_IDLE_SHUTDOWN_MINUTES=20

# Rooms with no activity for this long are marked complete.
ROOM_IDLE_TIMEOUT_MINUTES=240

ROOM_JANITOR_ENABLED=true
ROOM_JANITOR_INTERVAL_MINUTES=15
ROOM_JANITOR_INITIAL_DELAY_MS=30000

# Guest rows that never joined a table are deleted after this long. Guests are
# created on first visit, so without this the users table grows with crawlers.
UNUSED_GUEST_RETENTION_MINUTES=1440

# --- Test --------------------------------------------------------------------

# Used by `mix test` only. Must be a different database from DATABASE_URL: the
# suite truncates it.
TEST_DATABASE_URL=ecto://micupoker:CHANGE_ME@localhost/micupoker_test
