<main class="landing">
  <header class="topbar">
    <div>
      <p class="eyebrow">Play-money only</p>
      <h1>MicuPoker</h1>
    </div>
    <nav>
      <.link navigate={~p"/leaderboard"}>Leaderboard</.link>
      <.link navigate={~p"/docs"}>Docs</.link>
      <%= if @current_user && !@current_user.is_guest do %>
        <.link navigate={~p"/lobby"}>Lobby</.link>
        <form method="post" action={~p"/logout"}>
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <button type="submit">Sign out</button>
        </form>
      <% else %>
        <.link navigate={~p"/login"}>Sign in</.link>
      <% end %>
    </nav>
  </header>

  <section class="landing-hero">
    <div>
      <h1>Real Texas Hold'em.<br /><span>Zero real money.</span></h1>
      <p class="landing-lead">
        Server-authoritative shuffling, side pots, blinds and a proper betting clock.
        Sit down in one tap: no download, no wallet, no deposit. Works the same on a
        phone as on a desktop.
      </p>
      <div class="landing-cta">
        <.link navigate={~p"/lobby"} class="button primary">Play now</.link>
        <.link navigate={~p"/register"} class="button">Create account</.link>
      </div>
    </div>

    <div class="landing-art" aria-hidden="true">
      <span class="card black">
        <span class="card-rank">A</span><span class="card-suit">&#9824;</span>
      </span>
      <span class="card red">
        <span class="card-rank">K</span><span class="card-suit">&#9829;</span>
      </span>
      <span class="card red">
        <span class="card-rank">Q</span><span class="card-suit">&#9830;</span>
      </span>
      <span class="card black">
        <span class="card-rank">J</span><span class="card-suit">&#9827;</span>
      </span>
    </div>
  </section>

  <section class="notice">
    Virtual demo chips only. No deposits, withdrawals, payments, cash-out, crypto,
    or real-world value of any kind.
  </section>

  <section class="landing-stats" aria-label="Site activity">
    <div>
      <strong>{@stats.active_rooms}</strong>
      <span>Live tables</span>
    </div>
    <div>
      <strong>{@stats.completed_hands}</strong>
      <span>Hands dealt</span>
    </div>
    <div>
      <strong>{@stats.users}</strong>
      <span>Players</span>
    </div>
    <div>
      <strong>{@stats.rooms}</strong>
      <span>Tables opened</span>
    </div>
  </section>

  <section class="landing-grid">
    <article>
      <h3>The server deals</h3>
      <p>
        The deck, the shuffle, whose turn it is and who wins are all decided server-side.
        Your browser is sent your own cards and nobody else's until showdown.
      </p>
    </article>
    <article>
      <h3>Rules that hold up</h3>
      <p>
        Side pots, split pots, the big blind's option, uncalled bets returned, and an
        all-in below a full raise that does not reopen the betting.
      </p>
    </article>
    <article>
      <h3>Built for a phone</h3>
      <p>
        The table rotates so you are always at the bottom, seats spread to fit the table
        size, and the action bar stays under your thumb.
      </p>
    </article>
    <article>
      <h3>Play as a guest</h3>
      <p>
        No sign-up needed to sit down. Register later and your name, seats and hand
        history come with you.
      </p>
    </article>
    <article>
      <h3>Private tables</h3>
      <p>
        Give a table a password and share the link. Only people with the password get a
        seat, and the password is stored hashed.
      </p>
    </article>
    <article>
      <h3>Open by design</h3>
      <p>
        A documented JSON API for rooms and stats, plus a WebSocket protocol you can
        build your own client against.
      </p>
    </article>
  </section>

  <%= if @open_tables != [] do %>
    <section class="room-list" aria-label="Tables with open seats">
      <p class="eyebrow">Tables with open seats</p>
      <div class="rooms-table">
        <%= for room <- @open_tables do %>
          <div class="rooms-row">
            <strong>
              {room.name}
              <%= if MicuPoker.Rooms.protected?(room) do %>
                <span class="lock-badge" title="Password protected">&#128274;</span>
              <% end %>
            </strong>
            <span>{room.player_count}/{room.max_players} seated</span>
            <span>Blinds {room.small_blind}/{room.big_blind}</span>
            <span class="status">{room.status}</span>
            <.link navigate={~p"/rooms/#{room.id}"}>Sit down</.link>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <footer class="landing-footer">
    <span>MicuPoker &middot; play-money Texas Hold'em</span>
    <span>
      <.link navigate={~p"/docs"}>Docs</.link>
      &middot; <.link navigate={~p"/leaderboard"}>Leaderboard</.link>
      &middot; <.link href={~p"/api/stats"}>Stats API</.link>
      &middot; <.link navigate={~p"/lobby"}>Lobby</.link>
    </span>
  </footer>
</main>
