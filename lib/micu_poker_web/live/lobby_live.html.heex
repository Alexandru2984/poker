<main class="app-shell">
  <section class="topbar">
    <div>
      <p class="eyebrow">Play-money only</p>
      <h1>MicuPoker</h1>
    </div>
    <nav>
      <.link navigate={~p"/profile"}>Profile</.link>
      <.link navigate={~p"/calculator"}>Calculator</.link>
      <.link navigate={~p"/leaderboard"}>Leaderboard</.link>
      <.link navigate={~p"/docs"}>Docs</.link>
      <%= if @current_user.is_guest do %>
        <.link navigate={~p"/register"}>Keep this name</.link>
        <.link navigate={~p"/login"}>Sign in</.link>
      <% else %>
        <form method="post" action={~p"/logout"}>
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <button type="submit">Sign out</button>
        </form>
      <% end %>
    </nav>
  </section>

  <section class="notice">
    Virtual demo chips only. No deposits, withdrawals, payments, cash-out, crypto, or real-world value.
  </section>

  <section class="lobby-layout">
    <aside class="control-panel">
      <h2>{if @current_user.is_guest, do: "Guest Seat", else: "Your Account"}</h2>
      <p class="identity-chip">
        <strong>{@current_user.username}</strong>
        <span class="badge">{if @current_user.is_guest, do: "guest", else: "account"}</span>
      </p>
      <.form for={@name_form} phx-submit="rename">
        <.input field={@name_form[:username]} label="Display name" />
        <button type="submit">Update</button>
      </.form>
      <%= if @current_user.is_guest do %>
        <p class="range">
          Guest names disappear when the cookie does.
          <.link navigate={~p"/register"}>Create an account</.link>
          to keep this one.
        </p>
      <% end %>

      <h2>Quick Solo Practice</h2>
      <p class="range">
        Start an instant 6-max practice table populated with AI bots (play money only).
      </p>
      <div class="preset-strip" role="group" aria-label="Quick AI practice">
        <button
          type="button"
          phx-click="quick_practice"
          phx-value-bots="1"
          class="button primary"
        >
          &#9889; Heads-Up vs 1 Bot
        </button>
        <button
          type="button"
          phx-click="quick_practice"
          phx-value-bots="3"
          class="button primary"
        >
          &#9889; 4-Max vs 3 Bots
        </button>
      </div>

      <h2>Create Table</h2>
      <div class="preset-strip" role="group" aria-label="Stakes presets">
        <button type="button" phx-click="stake_preset" phx-value-preset="micro">
          Micro 5/10
        </button>
        <button type="button" phx-click="stake_preset" phx-value-preset="low">
          Low 10/25
        </button>
        <button type="button" phx-click="stake_preset" phx-value-preset="mid">
          Mid 25/50
        </button>
        <button type="button" phx-click="stake_preset" phx-value-preset="high">
          High 100/200
        </button>
      </div>
      <.form for={@room_form} phx-submit="create_room">
        <.input field={@room_form[:name]} label="Room name" value="Micu Table" />
        <div>
          <label for="room_currency">Fictional currency (play only)</label>
          <select id="room_currency" name="room[currency]">
            <%= for curr <- @currencies do %>
              <option value={curr.code} selected={curr.code == @room_defaults.currency}>
                {curr.code} — {curr.label}
              </option>
            <% end %>
          </select>
        </div>
        <.input
          type="number"
          field={@room_form[:max_players]}
          label="Max players"
          value={@room_defaults.max_players}
          min="2"
          max={MicuPoker.Rooms.Room.max_players()}
        />
        <.input
          type="number"
          field={@room_form[:starting_chips]}
          label="Starting chips"
          value={@room_defaults.starting_chips}
          min="100"
          max="100000"
        />
        <.input
          type="number"
          field={@room_form[:small_blind]}
          label="Small blind"
          value={@room_defaults.small_blind}
          min="1"
        />
        <.input
          type="number"
          field={@room_form[:big_blind]}
          label="Big blind"
          value={@room_defaults.big_blind}
          min="2"
        />
        <.input
          type="password"
          field={@room_form[:password]}
          label="Table password (optional)"
          value=""
          autocomplete="off"
          maxlength="200"
        />
        <label class="check-row">
          <input type="checkbox" name="room[spectator_enabled]" checked /> Spectators
        </label>
        <button type="submit">Create Room</button>
      </.form>
    </aside>

    <section class="room-list">
      <div class="lobby-toolbar">
        <div class="segmented">
          <button
            phx-click="filter"
            phx-value-filter="all"
            class={if @filter == "all", do: "active"}
          >
            All ({length(@rooms)})
          </button>
          <button
            phx-click="filter"
            phx-value-filter="available"
            class={if @filter == "available", do: "active"}
          >
            Open Seats
          </button>
          <button
            phx-click="filter"
            phx-value-filter="active"
            class={if @filter == "active", do: "active"}
          >
            Active
          </button>
          <button
            phx-click="filter"
            phx-value-filter="waiting"
            class={if @filter == "waiting", do: "active"}
          >
            Waiting
          </button>
        </div>

        <form id="lobby-search-form" phx-change="search" phx-submit="search" class="lobby-search">
          <input
            type="search"
            name="q"
            value={@search}
            placeholder="Filter by table name or currency..."
            aria-label="Filter tables"
            autocomplete="off"
          />
          <button type="button" phx-click="refresh" title="Refresh table list">Refresh</button>
        </form>
      </div>

      <% visible_rooms = filtered_rooms(@rooms, @filter, @search) %>
      <div class="rooms-table">
        <div class="rooms-head">
          <span>Room</span><span>Players</span><span>Stakes &amp; Currency</span><span>Status</span><span></span>
        </div>
        <%= for room <- visible_rooms do %>
          <div class="rooms-row">
            <strong>
              {room.name}
              <span class="currency-pill" title="Fictional currency">
                {room.currency || "CHIPS"}
              </span>
              <%= if MicuPoker.Rooms.protected?(room) do %>
                <span class="lock-badge" title="Password protected">&#128274;</span>
              <% end %>
            </strong>
            <span>{room.player_count}/{room.max_players}</span>
            <span>
              {room.small_blind}/{room.big_blind} &middot; {room.starting_chips} {room.currency ||
                "CHIPS"}
            </span>
            <span class="status">{room.status}</span>
            <.link navigate={~p"/rooms/#{room.id}"}>Join</.link>
          </div>
        <% end %>
        <%= if visible_rooms == [] do %>
          <div class="empty">No tables match this filter.</div>
        <% end %>
      </div>
    </section>
  </section>
</main>
