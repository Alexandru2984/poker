[Unit]
Description=MicuPoker database migration for release %i
After=postgresql.service
Requires=postgresql.service
OnFailure=swift-vapor-alert@%n.service

[Service]
Type=oneshot
User=micupoker
Group=micupoker
WorkingDirectory=/opt/micupoker/releases/%i
EnvironmentFile=/etc/micupoker/app.env
LoadCredential=database_url:/etc/micupoker/credentials/migrate_database_url
LoadCredential=secret_key_base:/etc/micupoker/credentials/secret_key_base
LoadCredential=admin_password:/etc/micupoker/credentials/admin_password
Environment=DATABASE_URL_FILE=%d/database_url
Environment=SECRET_KEY_BASE_FILE=%d/secret_key_base
Environment=ADMIN_PASSWORD_FILE=%d/admin_password
Environment=HOME=/run/micupoker-migrate-%i
Environment=RELEASE_TMP=/run/micupoker-migrate-%i
Environment=RELEASE_DISTRIBUTION=none
Environment=ERL_CRASH_DUMP=/run/micupoker-migrate-%i/erl_crash.dump
Environment=ERL_CRASH_DUMP_SECONDS=0

ExecStartPre=/usr/bin/test -x /opt/micupoker/releases/%i/bin/micu_poker
ExecStart=/opt/micupoker/releases/%i/bin/micu_poker eval MicuPoker.Release.migrate()

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateMounts=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
KeyringMode=private
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
RuntimeDirectory=micupoker-migrate-%i
RuntimeDirectoryMode=0700
ReadWritePaths=/run/micupoker-migrate-%i
TasksMax=256
MemoryMax=768M
CPUQuota=300%
