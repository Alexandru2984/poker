[Unit]
Description=MicuPoker Phoenix release
Documentation=https://poker.micutu.com/docs
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=micupoker
Group=micupoker
WorkingDirectory=/opt/micupoker/current
EnvironmentFile=/etc/micupoker/app.env
LoadCredential=database_url:/etc/micupoker/credentials/database_url
LoadCredential=secret_key_base:/etc/micupoker/credentials/secret_key_base
LoadCredential=admin_password:/etc/micupoker/credentials/admin_password
Environment=DATABASE_URL_FILE=%d/database_url
Environment=SECRET_KEY_BASE_FILE=%d/secret_key_base
Environment=ADMIN_PASSWORD_FILE=%d/admin_password
Environment=HOME=/run/micupoker
Environment=RELEASE_TMP=/run/micupoker
Environment=RELEASE_DISTRIBUTION=none
Environment=ERL_CRASH_DUMP=/var/lib/micupoker/erl_crash.dump
Environment=ERL_CRASH_DUMP_SECONDS=0

ExecStartPre=/usr/bin/test -x /opt/micupoker/current/bin/micu_poker
ExecStartPre=/usr/bin/test -r /opt/micupoker/current/.release-manifest.sha256
ExecStart=/opt/micupoker/current/bin/micu_poker start

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=micupoker

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateMounts=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
KeyringMode=private
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

RuntimeDirectory=micupoker
RuntimeDirectoryMode=0700
StateDirectory=micupoker
StateDirectoryMode=0700
ReadWritePaths=/run/micupoker /var/lib/micupoker

LimitNOFILE=65535
TasksMax=512
MemoryHigh=768M
MemoryMax=1G
CPUQuota=300%

[Install]
WantedBy=multi-user.target
